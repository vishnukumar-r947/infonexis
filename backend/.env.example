# INFONEXIS-AI Environment Variables
PORT=5000
FRONTEND_URL=http://localhost:5173

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/infonexis_ai

# JWT
JWT_SECRET=your_very_long_and_secure_jwt_secret_key_here
JWT_EXPIRE=7d

# LLM API (OpenAI-compatible)
LLM_API_KEY=your_openai_or_gemini_api_key_here
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini
LLM_MAX_TOKENS=2000

# SMS / OTP (Twilio or similar)
SMS_PROVIDER=demo
SMS_ACCOUNT_SID=your_twilio_account_sid
SMS_AUTH_TOKEN=your_twilio_auth_token
SMS_FROM_NUMBER=+1234567890
DEV_MODE_OTP=123456

# TTS (Browser native or Google TTS)
TTS_PROVIDER=browser

# File Upload
MAX_FILE_SIZE_MB=25
ALLOWED_FILE_TYPES=pdf,png,jpg,jpeg,webp,docx,txt
